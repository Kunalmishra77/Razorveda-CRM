# ── Database ────────────────────────────────────────────────────────────────
# TWO URLs, on purpose. Postgres table owners BYPASS RLS (D-21), so the API must
# never connect as the role that owns the tables.
#
# Migration + seed only. Owns the tables. Never used by apps/api.
DATABASE_URL=postgresql://razorveda_migrator:localdev@localhost:5432/razorveda
# The API. A LOGIN role that is a member of app_role and owns nothing.
DATABASE_URL_APP=postgresql://razorveda_app:localdev@localhost:5432/razorveda
DATABASE_APP_ROLE=app_role

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO / S3) ─────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=razorveda-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme
S3_REGION=ap-south-1

# ── Auth ────────────────────────────────────────────────────────────────────
# One-time secret for claiming the OWNER account (O-07, D-88).
#
# Provisioned OUT OF BAND by whoever deploys and handed to the business owner
# directly. It must NOT be shared with admins: OWNER exists precisely because
# "three admins with nobody above them is a gap" (docs/05), and an admin who
# could promote themselves would put the gap back while making it look closed.
#
# Unset means the account cannot be claimed at all. An unset secret must never
# mean "skip the check".
OWNER_CLAIM_TOKEN=

JWT_SECRET=generate-a-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_IDLE_TIMEOUT_MIN=10

# ── AI adapter ──────────────────────────────────────────────────────────────
# Used ONLY for: column mapping, disposition classification, SKU tie-break,
# Hinglish remark normalisation. Never for numbers. See CLAUDE.md rule 1.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_MAPPING_MIN_CONFIDENCE=0.90

# ── Security ────────────────────────────────────────────────────────────────
PII_COPY_VELOCITY_COUNT=4
PII_COPY_VELOCITY_WINDOW_SEC=90
UNTOUCHED_ALERT_HOURS=48
UNTOUCHED_RECALL_HOURS=72
EMPLOYEE_MAX_ROWS_PER_PAGE=50

# ── Notifications ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
TZ=Asia/Kolkata
