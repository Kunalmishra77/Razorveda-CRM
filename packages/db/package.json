{
  "name": "@razorveda/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "verify": "tsx src/verify.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pg:start": "tsx src/local-pg.ts start",
    "pg:stop": "tsx src/local-pg.ts stop",
    "pg:status": "tsx src/local-pg.ts status",
    "pg:destroy": "tsx src/local-pg.ts destroy",
    "seed:dev": "tsx src/seed-dev-fixture.ts",
    "seed:demo": "tsx src/seed-demo-day.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@razorveda/shared": "*",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^16.14.0-beta.17"
  }
}
